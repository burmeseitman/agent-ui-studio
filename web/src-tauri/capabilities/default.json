{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the app launch and manage its bundled agentui-daemon sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/agentui-daemon", "sidecar": true }]
    },
    "shell:allow-kill"
  ]
}
